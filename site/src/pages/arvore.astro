---
import Base from '../layouts/Base.astro';
import Ramo from '../components/Ramo.astro';
import {
  buscarPessoa,
  filhosDiretos,
  pessoas,
  totalDescendentes,
  TRONCO_FRANCOIS,
  TRONCO_SANTOS,
  TRONCO_VICTOR,
} from '../lib/arvore';

const victor = buscarPessoa(TRONCO_VICTOR)!;
const francois = buscarPessoa(TRONCO_FRANCOIS)!;
const santos = buscarPessoa(TRONCO_SANTOS)!;
const ramos = filhosDiretos(victor.id);
---

<Base
  titulo="Árvore Genealógica"
  descricao="Procure seu nome ou o de um antepassado e descubra de qual ramo da Família Dumont você descende."
>
  <section class="container cabecalho-pagina">
    <p class="sobretitulo">Árvore Genealógica</p>
    <h1>De qual ramo você vem?</h1>
    <p class="lead estreito">
      Digite o seu nome, o de seus pais ou o de seus avós. A árvore reúne {pessoas.length} familiares registrados no
      Esboço Genealógico da Família Dumont e mostra o caminho de cada um até os irmãos que vieram da França.
    </p>
  </section>

  <section class="container secao busca-secao">
    <label for="busca" class="busca-rotulo">Buscar na árvore</label>
    <input
      id="busca"
      type="search"
      autocomplete="off"
      placeholder="Ex.: Maria Eugênia, Vasconcelos, Redelvim..."
      aria-describedby="busca-ajuda"
    />
    <p id="busca-ajuda" class="ajuda">Não precisa de acentos. A busca também encontra quem entrou na família por casamento.</p>
    <div id="resultados" aria-live="polite"></div>
  </section>

  <section id="explorar" class="secao-clara" data-visao="vertical">
    <div class="explorar-interno">
      <div class="barra">
        <div class="grupo" role="group" aria-label="Forma de visualização">
          <span class="grupo-rotulo">Visualizar como</span>
          <button data-visao="vertical" aria-pressed="true">Árvore</button>
          <button data-visao="horizontal" aria-pressed="false">Gerações lado a lado</button>
          <button data-visao="lista" aria-pressed="false">Lista</button>
        </div>
        <div class="grupo so-diagrama" role="group" aria-label="Tronco da família">
          <span class="grupo-rotulo">Tronco</span>
          <button data-tronco={victor.id} aria-pressed="true">Victor Honoré</button>
          <button data-tronco={francois.id} aria-pressed="false">François Honoré</button>
          <button data-tronco={santos.id} aria-pressed="false">Família Santos</button>
        </div>
        <div class="grupo">
          <button data-expandir="true">Abrir tudo</button>
          <button data-expandir="false">Recolher tudo</button>
        </div>
      </div>

      <div class="explorar-grade">
        <div class="explorar-principal">
          <div id="palco" class="palco" data-orientacao="vertical">
            <div class="mundo"></div>
            <p class="palco-dica">Arraste para mover · role para dar zoom · clique em um nome para ver a ficha</p>
            <button class="palco-ficha" hidden></button>
            <div class="palco-controles">
              <button data-zoom="1.35" aria-label="Aproximar" title="Aproximar">+</button>
              <button data-zoom="0.74" aria-label="Afastar" title="Afastar">−</button>
              <button data-acao="tudo">Ver tudo</button>
              <button data-acao="tela">Tela cheia</button>
            </div>
          </div>

          <div class="lista">
            <p>Clique na seta para abrir os filhos de cada pessoa, ou no nome para ver a ficha dela.</p>
            <h3>Descendentes de Victor Honoré Dumont</h3>
            <ul class="arvore"><Ramo pessoa={victor} aberto /></ul>
            <h3>Descendentes de François Honoré Dumont</h3>
            <ul class="arvore"><Ramo pessoa={francois} aberto /></ul>
            <h3>Família Santos, linha materna de Alberto Santos Dumont</h3>
            <ul class="arvore"><Ramo pessoa={santos} aberto /></ul>
          </div>
        </div>

        <aside id="ficha" tabindex="-1" aria-label="Ficha da pessoa selecionada"></aside>
      </div>
    </div>
  </section>

  <section class="container secao">
    <h2>Os seis ramos de Victor e Rosalina</h2>
    <p class="estreito">
      Quase toda a árvore documentada descende dos seis filhos de Victor Honoré Dumont e Rosalina Adelaide Dumont,
      nascidos em Diamantina. Escolha um ramo para vê-lo na árvore.
    </p>
    <div class="grade ramos">
      {
        ramos.map((r, i) => (
          <a class={`cartao ramo-${i + 1}`} href={`#p=${r.id}`}>
            <p class="meta">Ramo {i + 1}</p>
            <h3>{r.nome}</h3>
            <p>{totalDescendentes(r.id)} descendentes registrados</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="secao secao-clara">
    <div class="container estreito">
      <h2>Não encontrou seu nome?</h2>
      <p>
        O Esboço Genealógico vai, na maior parte dos ramos, até a 4ª geração. Se você é Dumont e ainda não aparece aqui,
        procure o nome de seus avós ou bisavós e nos escreva contando quem são seus pais: a informação é conferida e
        entra na árvore.
      </p>
      <p><a class="botao" href="/contato/?assunto=arvore">Enviar minha linha da família</a></p>
    </div>
  </section>

  <script type="application/json" id="dados-arvore" set:html={JSON.stringify(pessoas)} />
</Base>

<script>
  import type { Pessoa } from '../lib/arvore';
  import { criarDiagrama, type Orientacao } from '../scripts/diagrama';

  const pessoas: Pessoa[] = JSON.parse(document.getElementById('dados-arvore')!.textContent!);
  const porId = new Map(pessoas.map((p) => [p.id, p]));
  const campo = document.getElementById('busca') as HTMLInputElement;
  const resultados = document.getElementById('resultados')!;
  const ficha = document.getElementById('ficha')!;
  const explorar = document.getElementById('explorar')!;
  const palco = document.getElementById('palco')!;
  const atalhoFicha = palco.querySelector<HTMLButtonElement>('.palco-ficha')!;

  const normalizar = (t: string) =>
    t
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase();
  const esc = (t: string) =>
    t.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const geracao = (g: number) => (g === 0 ? 'Tronco' : g < 0 ? 'Ascendente' : `${g}ª geração`);
  const link = (p: Pessoa) => `<a href="#p=${p.id}">${esc(p.nome)}</a>`;

  const diagrama = criarDiagrama(palco, pessoas, (id) => (location.hash = `p=${id}`));

  // Quem entrou na família por casamento não tem ficha própria: a busca leva à ficha do cônjuge.
  const indice = pessoas.flatMap((p) => [
    { chave: normalizar(p.nome), pessoa: p, conjuge: null as string | null },
    ...p.conjuges
      .filter((c) => !c.pessoaId && c.nome)
      .map((c) => ({ chave: normalizar(c.nome), pessoa: p, conjuge: c.nome })),
  ]);

  function linhagem(p: Pessoa): Pessoa[] {
    const linha = [p];
    while (linha[0].paiId) linha.unshift(porId.get(linha[0].paiId)!);
    return linha;
  }

  /** Filhos da pessoa agrupados por casamento, incluindo os registrados na ficha do cônjuge. */
  function filhosPorUniao(p: Pessoa) {
    const grupos: { com: string | null; filhos: Pessoa[] }[] = [];
    const juntar = (com: string | null, filhos: Pessoa[]) => filhos.length && grupos.push({ com, filhos });

    const proprios = pessoas.filter((f) => f.paiId === p.id);
    for (const uniao of [...new Set(proprios.map((f) => f.uniao))].sort()) {
      juntar(
        uniao ? (p.conjuges[uniao - 1]?.nome ?? null) : null,
        proprios.filter((f) => f.uniao === uniao),
      );
    }
    for (const c of p.conjuges) {
      const outro = c.pessoaId && porId.get(c.pessoaId);
      if (!outro) continue;
      const uniao = outro.conjuges.findIndex((x) => x.pessoaId === p.id) + 1;
      juntar(
        outro.nome,
        pessoas.filter((f) => f.paiId === outro.id && f.uniao === uniao),
      );
    }
    return grupos;
  }

  function contexto(p: Pessoa) {
    const partes = [geracao(p.geracao)];
    const ramo = p.ramoId && p.ramoId !== p.id ? porId.get(p.ramoId) : null;
    if (ramo) partes.push(`ramo de ${ramo.nome}`);
    const pai = p.paiId && porId.get(p.paiId);
    if (pai && pai !== ramo) partes.push(`filho(a) de ${pai.nome}`);
    return partes.join(' · ');
  }

  function buscar() {
    const termos = normalizar(campo.value).split(/\s+/).filter(Boolean);
    if (!termos.length || termos.join('').length < 2) {
      resultados.innerHTML = '';
      return;
    }
    const achados = indice
      .filter((e) => termos.every((t) => e.chave.includes(t)))
      .sort((a, b) => Number(b.chave.startsWith(termos[0])) - Number(a.chave.startsWith(termos[0])));
    if (!achados.length) {
      resultados.innerHTML = `<p class="vazio">Nenhum nome encontrado. Tente só o primeiro nome ou só o sobrenome, ou procure por seus avós.</p>`;
      return;
    }
    const LIMITE = 40;
    resultados.innerHTML =
      `<p class="contagem">${achados.length} ${achados.length === 1 ? 'resultado' : 'resultados'}${achados.length > LIMITE ? `, mostrando os ${LIMITE} primeiros` : ''}</p><ul class="lista-resultados">` +
      achados
        .slice(0, LIMITE)
        .map((e) =>
          e.conjuge
            ? `<li><a href="#p=${e.pessoa.id}"><strong>${esc(e.conjuge)}</strong><span>casado(a) com ${esc(e.pessoa.nome)} · ${esc(contexto(e.pessoa))}</span></a></li>`
            : `<li><a href="#p=${e.pessoa.id}"><strong>${esc(e.pessoa.nome)}</strong><span>${esc(contexto(e.pessoa))}</span></a></li>`,
        )
        .join('') +
      '</ul>';
  }

  function mostrarFicha(p: Pessoa) {
    const linha = linhagem(p);
    const pai = p.paiId ? porId.get(p.paiId)! : null;
    const outro = pai && p.uniao ? pai.conjuges[p.uniao - 1] : null;
    const outroHtml = outro
      ? outro.pessoaId
        ? link(porId.get(outro.pessoaId)!)
        : outro.nome
          ? esc(outro.nome)
          : ''
      : '';
    const conjuges = p.conjuges.filter((c) => c.nome);
    const grupos = filhosPorUniao(p);

    ficha.innerHTML = `
      <p class="sobretitulo">${esc(geracao(p.geracao))}</p>
      <h2>${esc(p.nome)}</h2>
      ${p.duvidoso ? '<p class="aviso">Parte desta ficha tem leitura incerta no documento original e ainda precisa ser conferida.</p>' : ''}
      <dl class="dados">
        ${pai ? `<div><dt>Filho(a) de</dt><dd>${link(pai)}${outroHtml ? ` e ${outroHtml}` : ''}</dd></div>` : ''}
        ${
          conjuges.length
            ? `<div><dt>${conjuges.length > 1 ? 'Casamentos' : 'Casou-se com'}</dt><dd>${conjuges
                .map((c, i) => {
                  const nome = c.pessoaId ? link(porId.get(c.pessoaId)!) : esc(c.nome);
                  return conjuges.length > 1 ? `${nome} (${i + 1}ª núpcia)` : nome;
                })
                .join('<br>')}</dd></div>`
            : ''
        }
        ${p.nota ? `<div><dt>Anotação</dt><dd>${esc(p.nota)}</dd></div>` : ''}
      </dl>

      <h3>Linha de descendência</h3>
      <ol class="linhagem">
        ${linha
          .map(
            (a) =>
              `<li${a === p ? ' class="atual"' : ''}><span>${esc(geracao(a.geracao))}</span>${a === p ? `<strong>${esc(a.nome)}</strong>` : link(a)}</li>`,
          )
          .join('')}
      </ol>

      <h3>Filhos</h3>
      ${
        grupos.length
          ? grupos
              .map(
                (g) => `
                  ${grupos.length > 1 || g.com ? `<p class="uniao">${g.com ? `Com ${esc(g.com)}` : 'Casamento não informado no documento'}</p>` : ''}
                  <ul class="filhos">${g.filhos
                    .map((f) => {
                      const cc = f.conjuges.map((c) => c.nome).filter(Boolean).join(' e ');
                      return `<li>${link(f)}${cc ? `<span>c.c. ${esc(cc)}</span>` : ''}</li>`;
                    })
                    .join('')}</ul>`,
              )
              .join('')
          : '<p class="vazio">Nenhum filho registrado no Esboço Genealógico. Se você conhece esta linha da família, <a href="/contato/?assunto=arvore">conte para nós</a>.</p>'
      }`;
    ficha.scrollTop = 0;
    atalhoFicha.hidden = false;
    atalhoFicha.textContent = `Ver ficha de ${p.nome} ↓`;
  }

  function marcarNaLista(p: Pessoa) {
    explorar.querySelector('.arvore a.atual')?.classList.remove('atual');
    const item = explorar.querySelector<HTMLElement>(`.arvore a[href="#p=${p.id}"]`);
    if (!item) return;
    item.classList.add('atual');
    for (let d = item.closest('details'); d; d = d.parentElement!.closest('details')) d.open = true;
    if (explorar.dataset.visao === 'lista') item.scrollIntoView({ block: 'center' });
  }

  function marcarTronco() {
    explorar
      .querySelectorAll<HTMLElement>('[data-tronco]')
      .forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.tronco === diagrama.tronco)));
  }

  /** `origem` diz de onde veio o pedido, para decidir se a página rola e se o diagrama recentraliza. */
  function selecionar(p: Pessoa, origem: 'diagrama' | 'fora' | 'ficha') {
    mostrarFicha(p);
    marcarNaLista(p);
    if (origem === 'fora') explorar.scrollIntoView({ block: 'start' });
    diagrama.selecionar(p.id, { centralizar: origem !== 'diagrama', animar: origem !== 'fora' });
    marcarTronco();
  }

  let origemDoClique: 'diagrama' | 'fora' | 'ficha' = 'fora';
  document.addEventListener(
    'click',
    (evento) => {
      const el = evento.target as HTMLElement;
      origemDoClique = el.closest('.mundo') ? 'diagrama' : el.closest('#explorar') ? 'ficha' : 'fora';
    },
    true,
  );

  function lerEndereco(inicial = false) {
    const id = decodeURIComponent(location.hash.replace(/^#p=/, ''));
    const p = location.hash.startsWith('#p=') ? porId.get(id) : undefined;
    if (p) selecionar(p, inicial ? 'fora' : origemDoClique);
    else if (inicial) mostrarFicha(porId.get(diagrama.tronco)!);
  }

  function mudarVisao(visao: string) {
    explorar.dataset.visao = visao;
    explorar
      .querySelectorAll<HTMLElement>('[data-visao]')
      .forEach((b) => b !== explorar && b.setAttribute('aria-pressed', String(b.dataset.visao === visao)));
    if (visao === 'lista') {
      explorar.querySelector<HTMLElement>('.arvore a.atual')?.scrollIntoView({ block: 'center' });
    } else {
      diagrama.orientar(visao as Orientacao);
      diagrama.reposicionar();
    }
    try {
      localStorage.setItem('arvore-visao', visao);
    } catch {
      // Navegação privada: a preferência só não é lembrada.
    }
  }

  explorar.querySelector('.barra')!.addEventListener('click', (evento) => {
    const botao = (evento.target as HTMLElement).closest<HTMLButtonElement>('button');
    if (!botao) return;
    if (botao.dataset.visao) mudarVisao(botao.dataset.visao);
    if (botao.dataset.tronco) {
      diagrama.mostrarTronco(botao.dataset.tronco);
      marcarTronco();
      mostrarFicha(porId.get(botao.dataset.tronco)!);
      history.replaceState(null, '', location.pathname);
    }
    if (botao.dataset.expandir) {
      const abrir = botao.dataset.expandir === 'true';
      if (explorar.dataset.visao === 'lista')
        explorar.querySelectorAll<HTMLDetailsElement>('.arvore details').forEach((d) => (d.open = abrir));
      else if (abrir) diagrama.expandirTudo();
      else diagrama.recolherTudo();
    }
  });

  palco.querySelector('.palco-controles')!.addEventListener('click', (evento) => {
    const botao = (evento.target as HTMLElement).closest<HTMLButtonElement>('button');
    if (!botao) return;
    if (botao.dataset.zoom) diagrama.zoom(Number(botao.dataset.zoom));
    if (botao.dataset.acao === 'tudo') diagrama.verTudo();
    if (botao.dataset.acao === 'tela') {
      if (document.fullscreenElement) document.exitFullscreen();
      else palco.requestFullscreen?.();
    }
  });

  atalhoFicha.addEventListener('click', async () => {
    if (document.fullscreenElement) await document.exitFullscreen();
    ficha.scrollIntoView({ block: 'start' });
    ficha.focus({ preventScroll: true });
  });

  document.addEventListener('fullscreenchange', () => {
    palco.querySelector('[data-acao="tela"]')!.textContent = document.fullscreenElement ? 'Sair da tela cheia' : 'Tela cheia';
    diagrama.reposicionar();
  });

  campo.addEventListener('input', buscar);
  window.addEventListener('hashchange', () => lerEndereco());

  let visaoSalva: string | null = null;
  try {
    visaoSalva = localStorage.getItem('arvore-visao');
  } catch {
    // Sem acesso ao armazenamento: fica a visualização padrão.
  }
  if (visaoSalva === 'horizontal' || visaoSalva === 'lista') mudarVisao(visaoSalva);
  lerEndereco(true);
</script>

<style is:global>
  .busca-secao {
    padding-bottom: 2rem;
  }
  .busca-rotulo {
    display: block;
    font-weight: 600;
    margin-bottom: 0.4rem;
  }
  #busca {
    width: 100%;
    max-width: 40rem;
    padding: 0.9rem 1rem;
    border: 2px solid var(--vinho);
    border-radius: 2px;
    background: #fff;
    font: inherit;
    font-size: 1.15rem;
  }
  .ajuda,
  .contagem {
    font-size: 0.9rem;
    color: var(--tinta-suave);
    margin: 0.4rem 0 0;
  }
  .lista-resultados {
    display: grid;
    gap: 0.5rem;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    margin: 0.8rem 0 0;
    padding: 0;
    list-style: none;
  }
  .lista-resultados a {
    display: block;
    height: 100%;
    padding: 0.7rem 0.9rem;
    background: var(--papel-claro);
    border: 1px solid var(--linha);
    border-left: 3px solid var(--ouro);
    color: var(--tinta);
    text-decoration: none;
  }
  .lista-resultados a:hover {
    border-left-color: var(--vinho);
  }
  .lista-resultados span {
    display: block;
    font-size: 0.85rem;
    color: var(--tinta-suave);
  }
  .vazio {
    color: var(--tinta-suave);
  }
  .aviso {
    padding: 0.6rem 0.9rem;
    border-left: 3px solid var(--ouro);
    background: #f3e7c9;
    font-size: 0.95rem;
  }

  /* Cores dos seis ramos de Victor (0 = demais troncos) */
  .ramo-0 {
    --cor-ramo: #1f3a5f;
  }
  .ramo-1 {
    --cor-ramo: #5b6cae;
  }
  .ramo-2 {
    --cor-ramo: #1c7fb5;
  }
  .ramo-3 {
    --cor-ramo: #2e8b57;
  }
  .ramo-4 {
    --cor-ramo: #b0762a;
  }
  .ramo-5 {
    --cor-ramo: #7d4e9c;
  }
  .ramo-6 {
    --cor-ramo: #c0452f;
  }
  .ramos .cartao {
    border-top-color: var(--cor-ramo);
  }

  #explorar {
    scroll-margin-top: 4.5rem;
  }
  .explorar-interno {
    max-width: 110rem;
    margin-inline: auto;
    padding: 1.25rem;
  }
  .barra {
    display: flex;
    gap: 0.6rem 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.9rem;
  }
  .grupo {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
  }
  .grupo-rotulo {
    margin-right: 0.6rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--tinta-suave);
  }
  .grupo button {
    margin-left: -1px;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--linha);
    background: #fff;
    color: var(--tinta);
    font: inherit;
    font-size: 0.92rem;
    font-weight: 600;
    cursor: pointer;
  }
  .grupo button:hover {
    background: var(--papel);
  }
  .grupo button[aria-pressed='true'] {
    position: relative;
    border-color: var(--vinho);
    background: var(--vinho);
    color: #fff;
  }
  #explorar[data-visao='lista'] .so-diagrama,
  #explorar[data-visao='lista'] .palco,
  #explorar:not([data-visao='lista']) .lista {
    display: none;
  }

  .explorar-grade {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: minmax(0, 1fr) 22rem;
    align-items: start;
  }
  .palco,
  .lista,
  #ficha {
    height: min(80vh, 54rem);
    min-height: 28rem;
    border: 1px solid var(--linha);
    background: #fff;
  }
  .lista,
  #ficha {
    padding: 1.25rem;
    overflow: auto;
  }
  .lista h3 {
    margin-top: 1.6rem;
  }
  .lista > p {
    margin: 0;
    color: var(--tinta-suave);
  }
  @media (max-width: 64rem) {
    .explorar-grade {
      grid-template-columns: 1fr;
    }
    .palco,
    .lista {
      height: 70vh;
    }
    #ficha {
      height: auto;
      min-height: 0;
      scroll-margin-top: 4.5rem;
    }
  }

  .palco {
    position: relative;
