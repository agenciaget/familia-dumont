---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatarData } from '../../config';

export async function getStaticPaths() {
  const artigos = await getCollection('blog', (a) => !a.data.rascunho);
  return artigos.map((artigo) => ({ params: { slug: artigo.id }, props: { artigo } }));
}

const { artigo } = Astro.props;
const { Content } = await render(artigo);
---

<Base titulo={artigo.data.titulo} descricao={artigo.data.resumo}>
  <article class="container estreito secao">
    <p class="sobretitulo"><a href="/blog/">Blog</a></p>
    <h1>{artigo.data.titulo}</h1>
    <p class="meta">{formatarData(artigo.data.data)} · {artigo.data.autor}</p>
    <div class="prosa">
      <Content />
    </div>
    <p class="voltar"><a href="/blog/">← Todos os artigos</a></p>
  </article>
</Base>

<style>
  .sobretitulo a {
    color: inherit;
  }
  .meta {
    color: var(--tinta-suave);
    margin: 0 0 2rem;
  }
  .voltar {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--linha);
  }
</style>
